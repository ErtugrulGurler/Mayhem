; Target editor: Godot 4.7.2. Uses stable Godot 4.x APIs.
config_version=5

[application]
config/name="Mayhem"
run/main_scene="res://prototype/scenes/session.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Action, physical production and base defense prototype."

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.14, 0.29, 0.17, 1)

[input_devices]
pointing/emulate_mouse_from_touch=true
