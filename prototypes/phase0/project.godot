; Independent Phase 0 sandbox. Open this file with Godot 4.3.
config_version=5

[application]
config/name="Mayhem — Faz 0"
config/description="Movement, eight-direction character animation and mobile controls sandbox."
run/main_scene="res://scenes/world.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/quit_on_go_back=false

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.21, 0.36, 0.25, 1)

[input_devices]
pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[input]
move_left={
"deadzone": 0.15,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194321)]
}
move_right={
"deadzone": 0.15,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194323)]
}
move_up={
"deadzone": 0.15,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.15,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}

[layer_names]
2d_physics/layer_1="World"
2d_physics/layer_2="Player"
